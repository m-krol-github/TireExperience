  "scripts": {
    "start": "node apps/tire-test-experience/server.js",
    "start-dev": "yarn build && cp -r apps/tire-test-experience/.next/static apps/tire-test-experience/.next/standalone/apps/tire-test-experience/.next && cp -r apps/tire-test-experience/public apps/tire-test-experience/.next/standalone/apps/tire-test-experience && node apps/tire-test-experience/.next/standalone/apps/tire-test-experience/server.js",
    "build": "NODE_ENV=production npx nx build tire-test-experience --skip-nx-cache",
    "test": "nx run-many --target=test --all --skip-nx-cache ",
    "test-watch": "nx run-many --all --target=test --parallel --watch",
    "check-types": "tsc --pretty --noEmit -p ./apps/tire-test-experience/tsconfig.json",
    "check-format": "prettier --check .",
    "check-lint": "eslint games/example-game/src libs/zustand-store/src apps/tire-test-experience/src --ext js,jsx,ts,tsx",
    "format": "prettier --write .",
    "test-all": "yarn check-format && yarn check-lint && yarn check-types && yarn test && yarn build",
    "prepare": "husky install .husky",
    "prepare-unix": "husky install .husky && chmod ug+x .husky/*"
  },
  "scriptsComments": {
    "start": "Start the server in production mode on Azure App Service",
    "start-dev": "Start the server in production mode on local machine",
    "prepare": "Windows: Run this before commiting anything. Install husky",
    "prepare-unix": "Unix: Run this before commiting anything. Install husky and make scripts executable"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.tsx": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.js": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ],
    "*.jsx": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  }
